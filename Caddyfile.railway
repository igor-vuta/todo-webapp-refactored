{
    admin off
    auto_https off
}

:{$PORT:80} {
    # Backend API under /api -> PHP files in /var/www/html
    handle_path /api/* {
        root * /var/www/html
        php_fastcgi 127.0.0.1:9000
        file_server
    }

    # Frontend static files
    handle {
        root * /srv/frontend
        try_files {path} {path}/ /index.html
        file_server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
