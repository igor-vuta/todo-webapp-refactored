{
    admin off
    auto_https off
}

:{$PORT:80} {
    root * /var/www/html
    
    # Try accessing PHP files
    php_fastcgi 127.0.0.1:9000
    
    # Enable file serving for static files
    file_server
    
    # Verbose logs
    log {
        output stdout
        format console
        level DEBUG
    }
}
